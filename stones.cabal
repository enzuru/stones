cabal-version:        2.4

-- cabal-version has to be the first line of the file, so the notice
-- that is at the top of every other file here is under it.
-- SPDX-FileCopyrightText: 2026 Elias Khanzada
-- SPDX-License-Identifier: GPL-3.0-or-later

name:                 stones
version:              0.1.0
synopsis:             Play Go against GNU Go, in a libadwaita window.
description:          Stones is a Go board. It keeps the rules itself
                      and plays them against GNU Go over the Go Text
                      Protocol, and it draws the board with cairo in a
                      libadwaita window built with gi-gtk4-declarative.
license:              GPL-3.0-or-later
license-file:         LICENSE
copyright:            2026 Elias Khanzada
author:               Elias Khanzada
maintainer:           lenzuru@gmail.com
category:             Game
build-type:           Simple
tested-with:          GHC == 9.10.3
extra-source-files:   README.md
                      LICENSE
data-files:           data/com.github.enzuru.Stones.desktop
                      data/icons/hicolor/scalable/apps/*.svg
                      data/icons/hicolor/symbolic/apps/*.svg
                      data/ui/*.ui

common warnings
  ghc-options:        -Wall -Wcompat -Wincomplete-record-updates
                      -Wincomplete-uni-patterns -Wredundant-constraints

library
  import:             warnings
  hs-source-dirs:     src
  default-language:   Haskell2010
  exposed-modules:    Go.Board
                    , Go.Game
                    , Go.Types
                    , Go.Vertex
                    , Stones.App
                    , Stones.Ogs
                    , Stones.Ogs.Account
                    , Stones.Ogs.Challenge
                    , Stones.Ogs.Frame
                    , Stones.Ogs.Login
                    , Stones.Ogs.Protocol
                    , Stones.Ogs.Seek
                    , Stones.Ogs.Socket
                    , Stones.Opponent
                    , Stones.Opponent.GnuGo
                    , Stones.Opponent.Ogs
                    , Stones.Online
                    , Stones.Opponent.Gtp
                    , Stones.Files
                    , Stones.Goban
                    , Stones.Goban.Geometry
                    , Stones.Menu
                    , Stones.Session
                    , Stones.Setup
  build-depends:      base                            >=4.10 && <5
                    , aeson                           >=2    && <3
                    , async                           >=2.2  && <2.3
                    , base64-bytestring               >=1    && <2
                    , bytestring                      >=0.10 && <0.13
                    , cryptohash-sha256               >=0.11 && <0.12
                    , http-client                     >=0.7  && <0.8
                    , http-client-tls                 >=0.3  && <0.4
                    , network                         >=3    && <4
                    , random                          >=1.2  && <1.4
                    , scientific                      >=0.3  && <0.4
                    , websockets                      >=0.12 && <0.14
                    , wuss                            >=2    && <3
                    , containers                      >=0.6  && <0.9
                    , gi-adwaita                      >=1    && <2
                    , gi-cairo-connector              >=0.1  && <0.2
                    , gi-cairo-render                 >=0.1  && <0.2
                    , gi-gio                          >=2    && <3
                    , gi-glib                         >=2    && <3
                    , gi-gobject                      >=2    && <3
                    , gi-gtk                          >=4    && <5
                    , gi-gtk4-declarative             >=0.8  && <0.9
                    , gi-gtk4-declarative-adwaita     >=0.8  && <0.9
                    , gi-gtk4-declarative-app-simple  >=0.8  && <0.9
                    , pipes                           >=4    && <5
                    , pipes-concurrency               >=2    && <3
                    , stm                             >=2.5  && <2.6
                    , directory                       >=1.3  && <1.4
                    , filepath                        >=1.4  && <1.6
                    , process                         >=1.6  && <1.7
                    , text                            >=1.2  && <2.2
                    , vector                          >=0.12 && <0.14

executable stones
  import:             warnings
  hs-source-dirs:     app
  main-is:            Main.hs
  default-language:   Haskell2010
  build-depends:      base
                    , directory                       >=1.3  && <1.4
                    , filepath                        >=1.4  && <1.6
                    , gi-adwaita
                    , gi-gdk
                    , gi-gio
                    , gi-gtk
                    , gi-gtk4-declarative-app-simple
                    , optparse-applicative            >=0.17 && <0.20
                    , stones
                    , text
  ghc-options:        -threaded -O2

test-suite stones-tests
  import:             warnings
  type:               exitcode-stdio-1.0
  hs-source-dirs:     test
  main-is:            Main.hs
  default-language:   Haskell2010
  other-modules:      AccountTest
                    , AppTest
                    , BoardTest
                    , ChallengeTest
                    , ClockTest
                    , OnlineTest
                    , DrawTest
                    , FakeEngineTest
                    , FrameTest
                    , LoginTest
                    , GameTest
                    , GeometryTest
                    , GtpTest
                    , OgsOpponentTest
                    , ProtocolMessageTest
                    , ProtocolTest
                    , SeekTest
                    , SessionTest
                    , SocketTest
                    , SetupTest
                    , TypesTest
                    , VertexTest
  build-depends:      base
                    , aeson
                    , bytestring                      >=0.10 && <0.13
                    , containers
                    , directory                       >=1.3  && <1.4
                    , gi-cairo-render                 >=0.1  && <0.2
                    , async
                    , http-client
                    , network
                    , pipes-concurrency
                    , stm
                    , websockets
                    , gi-gtk4-declarative-app-simple
                    , hedgehog                        >=1    && <2
                    , pipes                           >=4    && <5
                    , pipes-concurrency               >=2    && <3
                    , stm                             >=2.5  && <2.6
                    , stones
                    , text
                    , vector                          >=0.12 && <0.14
  ghc-options:        -threaded -rtsopts -with-rtsopts=-N

test-suite stones-widget-tests
  import:             warnings
  type:               exitcode-stdio-1.0
  hs-source-dirs:     widget-test
  main-is:            Main.hs
  default-language:   Haskell2010
  other-modules:      GobanWidgetTest
                    , IconTest
                    , WidgetUtils
                    , WindowTest
  build-depends:      base
                    , filepath                        >=1.4  && <1.6
                    , gi-adwaita
                    , gi-gdk
                    , gi-gio
                    , gi-glib
                    , gi-gtk
                    , gi-gtk4-declarative
                    , gi-gtk4-declarative-app-simple
                    , hedgehog                        >=1    && <2
                    , stones
                    , text
                    , vector
  ghc-options:        -threaded -rtsopts -with-rtsopts=-N
