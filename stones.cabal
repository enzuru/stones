cabal-version:        2.4

-- cabal-version has to be the first line of the file, so the notice
-- that is at the top of every other file here is under it.
-- SPDX-FileCopyrightText: 2026 Elias Khanzada
-- SPDX-License-Identifier: GPL-3.0-or-later

name:                 stones
version:              0.1.0
synopsis:             Play Go against GNU Go, in a libadwaita window.
description:          Stones is a Go board. It keeps the rules itself
                      and plays them against GNU Go over the Go Text
                      Protocol, and it draws the board with cairo in a
                      libadwaita window built with gi-gtk4-declarative.
license:              GPL-3.0-or-later
license-file:         LICENSE
copyright:            2026 Elias Khanzada
author:               Elias Khanzada
maintainer:           lenzuru@gmail.com
category:             Game
build-type:           Simple
tested-with:          GHC == 9.10.3
extra-source-files:   README.md
                      LICENSE

common warnings
  ghc-options:        -Wall -Wcompat -Wincomplete-record-updates
                      -Wincomplete-uni-patterns -Wredundant-constraints

library
  import:             warnings
  hs-source-dirs:     src
  default-language:   Haskell2010
  exposed-modules:    Go.Board
                    , Go.Game
                    , Go.Types
                    , Go.Vertex
                    , Stones.App
                    , Stones.Engine
                    , Stones.Engine.GnuGo
                    , Stones.Engine.Gtp
                    , Stones.Goban
                    , Stones.Goban.Geometry
                    , Stones.Session
  build-depends:      base                            >=4.10 && <5
                    , containers                      >=0.6  && <0.9
                    , gi-adwaita                      >=1    && <2
                    , gi-cairo-connector              >=0.1  && <0.2
                    , gi-cairo-render                 >=0.1  && <0.2
                    , gi-gobject                      >=2    && <3
                    , gi-gtk                          >=4    && <5
                    , gi-gtk4-declarative             >=0.8  && <0.9
                    , gi-gtk4-declarative-adwaita     >=0.8  && <0.9
                    , gi-gtk4-declarative-app-simple  >=0.8  && <0.9
                    , pipes                           >=4    && <5
                    , process                         >=1.6  && <1.7
                    , text                            >=1.2  && <2.2
                    , vector                          >=0.12 && <0.14

executable stones
  import:             warnings
  hs-source-dirs:     app
  main-is:            Main.hs
  default-language:   Haskell2010
  build-depends:      base
                    , gi-adwaita
                    , gi-gio
                    , gi-gtk4-declarative-app-simple
                    , stones
                    , text
  ghc-options:        -threaded -O2

test-suite stones-tests
  import:             warnings
  type:               exitcode-stdio-1.0
  hs-source-dirs:     test
  main-is:            Main.hs
  default-language:   Haskell2010
  other-modules:      AppTest
                    , BoardTest
                    , DrawTest
                    , FakeEngineTest
                    , GameTest
                    , GeometryTest
                    , GtpTest
                    , ProtocolTest
                    , SessionTest
                    , TypesTest
                    , VertexTest
  build-depends:      base
                    , bytestring                      >=0.10 && <0.13
                    , containers
                    , directory                       >=1.3  && <1.4
                    , filepath                        >=1.4  && <1.6
                    , gi-cairo-render                 >=0.1  && <0.2
                    , gi-gtk4-declarative-app-simple
                    , hedgehog                        >=1    && <2
                    , pipes                           >=4    && <5
                    , stones
                    , text
                    , vector                          >=0.12 && <0.14
  ghc-options:        -threaded -rtsopts -with-rtsopts=-N

test-suite stones-widget-tests
  import:             warnings
  type:               exitcode-stdio-1.0
  hs-source-dirs:     widget-test
  main-is:            Main.hs
  default-language:   Haskell2010
  other-modules:      GobanWidgetTest
                    , WidgetUtils
                    , WindowTest
  build-depends:      base
                    , gi-adwaita
                    , gi-gio
                    , gi-glib
                    , gi-gtk
                    , gi-gtk4-declarative
                    , gi-gtk4-declarative-app-simple
                    , hedgehog                        >=1    && <2
                    , stones
                    , text
                    , vector
  ghc-options:        -threaded -rtsopts -with-rtsopts=-N
